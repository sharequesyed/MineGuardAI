# MineGuard-AI Environment Configuration Example
# Copy to .env and adjust configuration as needed.

# Frontend Web Config
VITE_APP_TITLE="MineGuard-AI Surface Subsidence Monitoring"
VITE_BACKEND_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000/ws/telemetry"
VITE_DEFAULT_MODE="SIMULATION" # Options: SERIAL, GATEWAY_LOCAL, CLOUD, SIMULATION

# Backend Fast API Server Config
PORT=8000
HOST="0.0.0.0"
DATABASE_URL="sqlite:///./mineguard.db"
CORS_ORIGINS="http://localhost:5173,https://mineguard-ai.vercel.app"

# MQTT Broker Config (Cloud Gateway Relay)
MQTT_BROKER_HOST="broker.hivemq.com" # Default public test broker for student prototype
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY="mineguard/surface/telemetry"
MQTT_TOPIC_ALERTS="mineguard/surface/alerts"
MQTT_CLIENT_ID="mineguard_backend_service"

# Environment Mode
ENVIRONMENT="development" # Options: development, staging, production
